# EcoVision configuration.
#
# All settings for the robot scripts (actions.py, project/suggest.py,
# inference.py) live here. Edit the values below to match your machine.


# ── Groq API key ───────────────────────────────────────────────────────────
# Used to ask the LLM for recycling advice.
# Get a free key at https://console.groq.com  → API Keys.
GROQ_API_KEY=GROQ_API_KEY_REDACTED


# ── Robot motor port ───────────────────────────────────────────────────────
# The serial port the Gretchen motors are connected to. This differs by OS and
# by machine — pick the line that matches yours and put it after the `=`.
#
#   macOS      /dev/tty.usbserial-FT94ELHH   run `ls /dev/tty.usbserial-*`
#                                            to find yours; the suffix varies
#                                            per USB adapter.
#   Windows    COM4                          check Device Manager → Ports
#                                            (COM & LPT); often COM3 or COM4.
#   Linux      /dev/grt_motor                the udev rule shipped with
#              (or /dev/ttyUSB0)             gretchen; falls back to ttyUSB0.
ROBOT_MOTOR_PORT=/dev/tty.usbserial-FT94ELHH


# ── Robot camera ───────────────────────────────────────────────────────────
# Which camera to read frames from. On macOS/Windows this is an index number;
# on Linux it can be an index or a device path.
#
#   macOS      0    built-in / first USB webcam. Try 1 for an external cam.
#   Windows    0    first camera. Try 1, 2… if the wrong one opens.
#   Linux      0    or a path such as /dev/grt_cam / /dev/video0.
#
# A plain number is used as a camera index; anything else is treated as a
# device path.
ROBOT_CAMERA=0
